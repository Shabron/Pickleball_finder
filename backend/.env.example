PORT=8082
MONGODB_URI=
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRE=7d

# Email (used to send password reset codes)
#
# Option A — Gmail (easiest for a small/personal project):
#   1. Enable 2-Step Verification on the Gmail account: https://myaccount.google.com/security
#   2. Create an "App Password": https://myaccount.google.com/apppasswords
#   3. Set EMAIL_SERVICE=gmail, EMAIL_USER=<that gmail address>, EMAIL_PASS=<the 16-char app password>
#
# Option B — Any SMTP provider (SendGrid, Mailgun, Amazon SES, Resend, etc.):
#   Leave EMAIL_SERVICE blank and set EMAIL_HOST / EMAIL_PORT instead, e.g.
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_PORT=587
#   EMAIL_USER=apikey
#   EMAIL_PASS=<provider API key/password>
EMAIL_SERVICE=gmail
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
